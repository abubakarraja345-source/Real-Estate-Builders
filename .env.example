# Supabase project settings (Project Settings > API in the Supabase dashboard).
# Safe to expose to the browser: protected only by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_,
# never import from client code, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
